# ─── Supabase (hosted) ────────────────────────────────────
# Project: hrdaddy (ref mtzkhisddplixfabycud, ap-southeast-1)
# Default path. For a fully self-hosted stack (no hosted Supabase project),
# comment this block out and use the "Supabase (self-hosted)" block below instead.
NEXT_PUBLIC_SUPABASE_URL="https://mtzkhisddplixfabycud.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ThnRcGjQQ5oE59JL2ZqmYg_yn0GVmBp"

# OPTIONAL. Only needed by background jobs (getStorageUnscoped).
# Nothing in the request path uses it — document access runs on the caller's own
# session so storage RLS applies. Bypasses all policies; never expose to the browser.
SUPABASE_SECRET_KEY=""

# ─── Supabase (self-hosted) ───────────────────────────────
# Alternative to the hosted block above — use this when running the
# gotrue/postgrest/storage-api/kong services added to docker-compose.yml
# instead of a hosted Supabase project. Uncomment and fill in in place of the
# hosted block; do not set both at once. See supabase/init.sql and
# docker-compose.yml for how these services fit together.
#
# The publishable/anon key below is safe to expose in the browser; the
# service-role key bypasses RLS and must remain server-side. Both are JWTs
# signed by SUPABASE_JWT_SECRET — regenerate all three before anything beyond
# local dev.
#
# SUPABASE_URL="http://localhost:8000"
# NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
# SUPABASE_JWT_SECRET="local-dev-jwt-secret-change-me-before-production-please"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzEwMDAwMDAwLCJleHAiOjE4OTM0NTYwMDB9.c9RlKxgPm8jgrRipCJGJ8dv1dBHSN52c0lccBLM5Qzo"
# SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MTAwMDAwMDAsImV4cCI6MTg5MzQ1NjAwMH0.beONMRAmVG_S4PPCzANHnbBeNl6iu9gJKyMF6MMcN9U"
#
# GoTrue email/password settings for the self-hosted `gotrue` service.
# Autoconfirm is convenient for local dev; disable it and configure real SMTP
# credentials for anything beyond local dev.
# GOTRUE_JWT_EXP="3600"
# GOTRUE_JWT_ADMIN_GROUP_NAME="service_role"
# GOTRUE_DISABLE_SIGNUP="false"
# GOTRUE_EXTERNAL_EMAIL_ENABLED="true"
# GOTRUE_MAILER_AUTOCONFIRM="true"
# GOTRUE_URI_ALLOW_LIST="http://localhost:3000/**"
# GOTRUE_SMTP_ADMIN_EMAIL="admin@example.com"
# GOTRUE_SMTP_HOST="localhost"
# GOTRUE_SMTP_PORT="2500"
# GOTRUE_SMTP_USER=""
# GOTRUE_SMTP_PASS=""
# GOTRUE_SMTP_SENDER_NAME="HRDaddy"

# ─── Database ─────────────────────────────────────────────
# REQUIRED. Dashboard > Project Settings > Database > Connection string > URI.
# The password is set once at project creation and is never retrievable through
# the API — it can only be reset — so this is the one value that has to be
# pasted in by hand.
#
# DATABASE_URL must use the TRANSACTION pooler (port 6543, ?pgbouncer=true).
# The app's runtime PrismaPg adapter opens one connection per request; on a
# serverless host the SESSION pooler (port 5432) holds one dedicated backend
# connection per invocation and exhausts Supabase's connection cap under any
# real concurrency ("max clients reached in session mode"). DIRECT_URL stays
# on the session pooler (5432) — migrations need a direct/session connection
# because DDL and advisory locks don't work over the transaction pooler.
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://...:5432/postgres?connection_limit=25&pool_timeout=30"

# For the self-hosted stack instead, both point at the local postgres service
# added in docker-compose.yml — there is no separate pooler locally, so both
# URLs are the same connection:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrdaddy?connection_limit=10&pool_timeout=30"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hrdaddy?connection_limit=25&pool_timeout=30"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Email (Resend) ──────────────────────────────────────
# OPTIONAL. When unset, email notifications degrade gracefully — in-app
# notifications still fire, emails are simply skipped. Set this to enable
# transactional email delivery via Resend (https://resend.com).
RESEND_API_KEY=""

# The "From" address for notification emails.
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM="HRDaddy <notifications@yourdomain.com>"

# ─── Employee PII encryption ──────────────────────────────
# REQUIRED for storing and reading encrypted national IDs and bank details.
# This MUST be a real, securely generated and securely stored 32-byte base64 key
# in any real deployment. Losing it makes existing encrypted data permanently
# unrecoverable; back it up accordingly.
EMPLOYEE_PII_ENCRYPTION_KEY="m0e3J8sN5xQ2vL7aC4pR9tY1uI6oP3kW8zF5hG2dB7A="
