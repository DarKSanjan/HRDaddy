// HR Daddy - Prisma Schema
// Multi-tenant HR management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum OrgRole {
  OWNER
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmploymentStatus {
  DRAFT
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum AttendanceType {
  OFFICE
  REMOTE
}

enum AttendanceStatus {
  OPEN
  CLOSED
  MISSING_CLOCK_OUT
  CORRECTED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingAssigneeType {
  EMPLOYEE
  MANAGER
  HR
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum PayrollPeriodStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  PAID
  ARCHIVED
}

enum PayrollLineItemType {
  EARNING
  ALLOWANCE
  DEDUCTION
}

// ─────────────────────────────────────────────
// Identity & Auth
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   OrganisationMembership[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Organisation & Membership
// ─────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    OrganisationSettings?
  memberships OrganisationMembership[]
  invitations Invitation[]

  employees       Employee[]
  departments     Department[]
  jobTitles       JobTitle[]
  workLocations   WorkLocation[]
  employmentTypes EmploymentType[]

  leaveTypes    LeaveType[]
  leavePolicies LeavePolicy[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  attendanceRecords AttendanceRecord[]

  onboardingTemplates OnboardingTemplate[]
  employeeOnboardings EmployeeOnboarding[]

  documentCategories DocumentCategory[]
  employeeDocuments  EmployeeDocument[]

  payrollPeriods PayrollPeriod[]
  payrollRecords PayrollRecord[]

  notifications Notification[]
  auditLogs     AuditLog[]

  // Task-level relation
  onboardingTasks  EmployeeOnboardingTask[]
  payrollLineItems PayrollLineItem[]

  @@map("organisations")
}

model OrganisationSettings {
  id                String   @id @default(cuid())
  orgId             String   @unique
  timezone          String   @default("UTC")
  currency          String   @default("USD")
  dateFormat         String   @default("YYYY-MM-DD")
  workingDays       Json     @default("[1,2,3,4,5]")
  workingHoursStart String   @default("09:00")
  workingHoursEnd   String   @default("17:00")
  leaveYearStart    String   @default("01-01")
  brandPrimaryColor String?
  brandLogoUrl      String?

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("organisation_settings")
}

model OrganisationMembership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("organisation_memberships")
}

model Invitation {
  id        String           @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole          @default(EMPLOYEE)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
  @@map("invitations")
}

// ─────────────────────────────────────────────
// Employee & Org Structure
// ─────────────────────────────────────────────

model Employee {
  id               String           @id @default(cuid())
  orgId            String
  userId           String?
  firstName        String
  lastName         String
  workEmail        String
  personalEmail    String?
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  nationalId       String?
  address          String?
  employmentStatus EmploymentStatus @default(DRAFT)
  startDate        DateTime?
  endDate          DateTime?
  departmentId     String?
  jobTitleId       String?
  locationId       String?
  employmentTypeId String?
  managerId        String?

  compensationAmount   Int?
  compensationCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department     Department?     @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  jobTitle       JobTitle?       @relation(fields: [jobTitleId], references: [id])
  workLocation   WorkLocation?   @relation(fields: [locationId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  manager        Employee?       @relation("EmployeeManager", fields: [managerId], references: [id])

  directReports Employee[] @relation("EmployeeManager")

  managedDepartments Department[] @relation("DepartmentManager")

  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  reviewedLeaves LeaveRequest[] @relation("LeaveReviewer")

  attendanceRecords    AttendanceRecord[]
  correctedAttendances AttendanceRecord[] @relation("AttendanceCorrector")

  onboardings EmployeeOnboarding[]

  documents         EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("DocumentUploader")

  payrollRecords PayrollRecord[]

  @@index([orgId])
  @@index([userId])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model Department {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  managerId  String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  employees    Employee[]   @relation("EmployeeDepartment")

  @@index([orgId])
  @@map("departments")
}

model JobTitle {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([orgId])
  @@map("job_titles")
}

model WorkLocation {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([orgId])
  @@map("work_locations")
}

model EmploymentType {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([orgId])
  @@map("employment_types")
}

// ─────────────────────────────────────────────
// Leave Management
// ─────────────────────────────────────────────

model LeaveType {
  id                 String   @id @default(cuid())
  orgId              String
  name               String
  color              String   @default("#3B82F6")
  requiresApproval   Boolean  @default(true)
  requiresDocument   Boolean  @default(false)
  maxConsecutiveDays Int?
  createdAt          DateTime @default(now())

  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policies     LeavePolicy[]
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@index([orgId])
  @@map("leave_types")
}

model LeavePolicy {
  id              String  @id @default(cuid())
  orgId           String
  leaveTypeId     String
  defaultAllowance Decimal @db.Decimal(5, 2)
  carryOverLimit  Decimal @db.Decimal(5, 2) @default(0)
  accrualEnabled  Boolean @default(false)
  createdAt       DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("leave_policies")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  orgId       String
  employeeId  String
  leaveTypeId String
  year        Int
  allowance   Decimal  @db.Decimal(5, 2)
  used        Decimal  @db.Decimal(5, 2) @default(0)
  pending     Decimal  @db.Decimal(5, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([orgId])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String             @id @default(cuid())
  orgId         String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  isHalfDay     Boolean            @default(false)
  halfDayPeriod String?
  totalDays     Decimal            @db.Decimal(4, 1)
  reason        String?
  status        LeaveRequestStatus @default(DRAFT)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  reviewedBy   Employee?    @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([orgId])
  @@index([employeeId])
  @@map("leave_requests")
}

// ─────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────

model AttendanceRecord {
  id               String           @id @default(cuid())
  orgId            String
  employeeId       String
  date             DateTime
  clockIn          DateTime
  clockOut         DateTime?
  durationMinutes  Int?
  type             AttendanceType   @default(OFFICE)
  status           AttendanceStatus @default(OPEN)
  correctedById    String?
  correctionReason String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  correctedBy  Employee?    @relation("AttendanceCorrector", fields: [correctedById], references: [id])

  @@index([orgId])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────
// Onboarding
// ─────────────────────────────────────────────

model OnboardingTemplate {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  organisation Organisation             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks        OnboardingTemplateTask[]
  onboardings  EmployeeOnboarding[]

  @@index([orgId])
  @@map("onboarding_templates")
}

model OnboardingTemplateTask {
  id           String                 @id @default(cuid())
  templateId   String
  title        String
  description  String?
  assigneeType OnboardingAssigneeType
  dueInDays    Int
  sortOrder    Int

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("onboarding_template_tasks")
}

model EmployeeOnboarding {
  id          String           @id @default(cuid())
  orgId       String
  employeeId  String
  templateId  String
  status      OnboardingStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     OnboardingTemplate @relation(fields: [templateId], references: [id])
  tasks        EmployeeOnboardingTask[]

  @@index([orgId])
  @@index([employeeId])
  @@map("employee_onboardings")
}

model EmployeeOnboardingTask {
  id           String                 @id @default(cuid())
  onboardingId String
  orgId        String
  title        String
  description  String?
  assigneeType OnboardingAssigneeType
  assigneeId   String?
  dueDate      DateTime?
  status       OnboardingTaskStatus   @default(PENDING)
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  onboarding   EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([orgId])
  @@map("employee_onboarding_tasks")
}

// ─────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────

model DocumentCategory {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents    EmployeeDocument[]

  @@index([orgId])
  @@map("document_categories")
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  orgId        String
  employeeId   String
  categoryId   String
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  expiresAt    DateTime?
  isArchived   Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee         @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Cascade)
  category     DocumentCategory @relation(fields: [categoryId], references: [id])
  uploadedBy   Employee         @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([orgId])
  @@index([employeeId])
  @@map("employee_documents")
}

// ─────────────────────────────────────────────
// Payroll
// ─────────────────────────────────────────────

model PayrollPeriod {
  id          String              @id @default(cuid())
  orgId       String
  name        String
  startDate   DateTime
  endDate     DateTime
  status      PayrollPeriodStatus @default(DRAFT)
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  records      PayrollRecord[]

  @@index([orgId])
  @@map("payroll_periods")
}

model PayrollRecord {
  id          String   @id @default(cuid())
  orgId       String
  periodId    String
  employeeId  String
  grossAmount Int
  netAmount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lineItems    PayrollLineItem[]

  @@index([orgId])
  @@index([periodId])
  @@map("payroll_records")
}

model PayrollLineItem {
  id        String              @id @default(cuid())
  recordId  String
  orgId     String
  type      PayrollLineItemType
  name      String
  amount    Int
  createdAt DateTime            @default(now())

  record       PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([orgId])
  @@map("payroll_line_items")
}

// ─────────────────────────────────────────────
// Notifications & Audit
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([orgId])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
