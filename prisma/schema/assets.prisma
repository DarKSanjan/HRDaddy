// HR Daddy - Asset Management schema

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RETIRED
  LOST
}

model AssetCategory {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  name       String
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")

  organisation  Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assets        Asset[]
  assetRequests AssetRequest[]

  @@index([orgId])
  @@map("asset_categories")
}

model Asset {
  id                  String      @id @default(cuid())
  orgId               String      @map("org_id")
  categoryId          String      @map("category_id")
  name                String
  assetTag            String      @map("asset_tag")
  status              AssetStatus @default(AVAILABLE)
  purchaseDate        DateTime?   @map("purchase_date")
  purchaseValueCents  Int?        @map("purchase_value_cents")
  notes               String?
  currentAssignmentId String?     @unique @map("current_assignment_id")
  personInChargeId    String?     @map("person_in_charge_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  organisation      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category          AssetCategory    @relation(fields: [categoryId], references: [id])
  currentAssignment AssetAssignment? @relation("CurrentAssignment", fields: [currentAssignmentId], references: [id])
  personInCharge    Employee?        @relation("AssetPersonInCharge", fields: [personInChargeId], references: [id], onDelete: SetNull)
  assignments       AssetAssignment[] @relation("AssetAssignments")
  requestedIn       AssetRequest[]   @relation("RequestedAsset")
  fulfilledIn       AssetRequest[]   @relation("FulfilledAsset")

  @@unique([orgId, assetTag])
  @@index([orgId])
  @@index([orgId, status])
  @@map("assets")
}

model AssetAssignment {
  id                    String    @id @default(cuid())
  orgId                 String    @map("org_id")
  assetId               String    @map("asset_id")
  employeeId            String    @map("employee_id")
  assignedAt            DateTime  @default(now()) @map("assigned_at")
  assignedById          String    @map("assigned_by_id")
  returnedAt            DateTime? @map("returned_at")
  returnedById          String?   @map("returned_by_id")
  conditionAtAssignment String?   @map("condition_at_assignment")
  conditionAtReturn     String?   @map("condition_at_return")
  notes                 String?

  organisation       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset              Asset        @relation("AssetAssignments", fields: [assetId], references: [id], onDelete: Cascade)
  employee           Employee     @relation("EmployeeAssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy         Employee     @relation("AssetAssignedBy", fields: [assignedById], references: [id])
  returnedBy         Employee?    @relation("AssetReturnedBy", fields: [returnedById], references: [id])
  currentForAsset    Asset?       @relation("CurrentAssignment")

  @@index([orgId])
  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model AssetRequest {
  id               String             @id @default(cuid())
  orgId            String             @map("org_id")
  employeeId       String             @map("employee_id")
  categoryId       String             @map("category_id")
  requestedAssetId String?            @map("requested_asset_id")
  reason           String
  status           AssetRequestStatus @default(PENDING)
  requestedAt      DateTime           @default(now()) @map("requested_at")
  reviewedById     String?            @map("reviewed_by_id")
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewNote       String?            @map("review_note")
  fulfilledAssetId String?            @map("fulfilled_asset_id")

  organisation   Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee       Employee      @relation("EmployeeAssetRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  category       AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requestedAsset Asset?        @relation("RequestedAsset", fields: [requestedAssetId], references: [id], onDelete: SetNull)
  reviewedBy     Employee?     @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])
  fulfilledAsset Asset?        @relation("FulfilledAsset", fields: [fulfilledAssetId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, status])
  @@index([employeeId])
  @@map("asset_requests")
}
