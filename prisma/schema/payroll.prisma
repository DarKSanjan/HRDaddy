// HR Daddy - Payroll schema

model PayrollPeriod {
  id           String              @id @default(cuid())
  orgId        String              @map("org_id")
  name         String
  startDate    DateTime            @map("start_date")
  endDate      DateTime            @map("end_date")
  status       PayrollPeriodStatus @default(DRAFT)
  approvedById String?             @map("approved_by_id")
  approvedAt   DateTime?           @map("approved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  records      PayrollRecord[]

  @@index([orgId])
  @@map("payroll_periods")
}

model PayrollRecord {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  periodId         String   @map("period_id")
  employeeId       String   @map("employee_id")
  grossAmountCents Int      @map("gross_amount_cents")
  netAmountCents   Int      @map("net_amount_cents")
  cpfTotalCents    Int?     @map("cpf_total_cents")
  cpfEmployeeCents Int?     @map("cpf_employee_cents")
  cpfEmployerCents Int?     @map("cpf_employer_cents")
  ytdOwCents       Int?     @map("ytd_ow_cents")
  isPublished      Boolean  @default(false) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       PayrollPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lineItems    PayrollLineItem[]

  @@index([orgId])
  @@index([periodId])
  @@map("payroll_records")
}

model PayrollLineItem {
  id          String              @id @default(cuid())
  recordId    String              @map("record_id")
  orgId       String              @map("org_id")
  type        PayrollLineItemType
  name        String
  amountCents Int                 @map("amount_cents")
  createdAt   DateTime            @default(now()) @map("created_at")

  record       PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([orgId])
  @@map("payroll_line_items")
}
